# Copy to backend/.env and fill in. backend/.env is gitignored.

# Fallback order: the first provider is tried first, then the rest.
LLM_PROVIDERS=claude,openai,gemini

# Model names change often: copy current ones from each provider's docs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# Defaults to a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
